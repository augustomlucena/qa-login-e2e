{
  "info": {
    "_postman_id": "b7d6f1f0-8d7c-4c67-9e35-qa-login-e2e",
    "name": "QA - Login API",
    "description": "Collection de testes automatizados para a funcionalidade de login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.com"
    },
    {
      "key": "email",
      "value": "usuario.qa@example.com"
    },
    {
      "key": "password",
      "value": "Qa@123456"
    }
  ],
  "item": [
    {
      "name": "Login - Credenciais válidas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code deve ser 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Tempo de resposta menor que 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test('Resposta deve possuir token', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login - Credenciais inválidas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario.inexistente@example.com\",\n  \"password\": \"SenhaInvalida123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 401 ou 403', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});",
              "",
              "pm.test('Resposta deve ocorrer em menos de 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login - Campos obrigatórios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API deve rejeitar dados inválidos', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
